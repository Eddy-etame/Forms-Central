# ---------------------------------------------------------------------------
# Inlet — environment variables. Copy to .env.local (never committed).
# Production: set the same names as Vercel project secrets.
# ---------------------------------------------------------------------------

# Public origin of this deployment (links in e-mails, snippets, MCP output)
NEXT_PUBLIC_APP_URL=https://eam-inlet.vercel.app
# Canonical marketing origin (sitemap, SEO). Usually the same as above.
NEXT_PUBLIC_SITE_URL=https://eam-inlet.vercel.app

# Supabase — the service role key bypasses RLS: server-side only, never NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Sessions (developer, client portal, operator). 32+ random chars.
JWT_SECRET=
# Encrypts stored SMTP passwords of custom senders (32 bytes, base64 or hex)
CLIENT_ENCRYPTION_KEY=

# Operator (admin) sign-in: sha256 hex of the password → node scripts/set-admin-password.mjs "…"
ADMIN_PASSWORD_HASH=
# Where the operator's OTP codes and plan requests go
ADMIN_2FA_EMAIL=
# Optional: a separate inbox for plan requests (falls back to ADMIN_2FA_EMAIL)
OPERATOR_EMAIL=
# Address published on /legal/privacy and /legal/terms (defaults to OPERATOR_EMAIL)
LEGAL_CONTACT_EMAIL=
# Optional: the operator's own "atelier" developer account e-mail (admin shortcut)
ATELIER_EMAIL=

# Outgoing e-mail — a POOL of sending accounts. Account 1 is SMTP_*; add SMTP_2_*, SMTP_3_* …
# (host/port/secure inherit from account 1 unless SMTP_<n>_HOST/_PORT/_SECURE are set).
# Sends rotate across healthy accounts; an account that fails is cooled down, never silently skipped
# — every send is logged, a failed send is a logged failure.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender header. Must be a verified sender on that account.
SMTP_FROM="Inlet" <no-reply@your-domain.com>
# SMTP_2_USER=
# SMTP_2_PASS=
# SMTP_2_FROM="Inlet" <no-reply@your-domain.com>
# SMTP_<n>_DISABLED=true pauses one account without deleting it

# AI assistant (marketing chat + optional spam classifier). Any number of Gemini keys.
GEMINI_API_KEY_1=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# The AI spam classifier only runs when this is exactly "true" (court order A4)
AI_CLASSIFIER_ENABLED=false

# Google sign-in (not wired in production; leave disabled)
NEXT_PUBLIC_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Data retention job (/api/cron/retention). OFF by default. To run it: CRON_SECRET (bearer the scheduler sends),
# RETENTION_ENABLED=true, and RETENTION_APPLY=true to really delete (otherwise it only reports). Add the schedule
# back to vercel.json ("crons") once a dry run looked right.
CRON_SECRET=
RETENTION_ENABLED=false
RETENTION_APPLY=false

# Used only by the integration test scripts (scripts/test-*.mjs)
FORM_API_URL=http://localhost:3000
FORM_ID=
INLET_API_KEY=
